# "mock" (default) runs the in-browser demo backend; "http" calls the Express API.
NEXT_PUBLIC_API_MODE=mock
# Base path of the API when NEXT_PUBLIC_API_MODE=http (served on the same domain via the reverse proxy).
NEXT_PUBLIC_API_BASE=/api/v1
# Where Next.js forwards /api/v1 in development when NEXT_PUBLIC_API_MODE=http (the API's dev server).
API_PROXY_TARGET=http://localhost:4000

# Public origin, used for canonical URLs, sitemap.xml and Open Graph images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
