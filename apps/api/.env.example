# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Docker Compose Postgres (see docker-compose.yml); 5433 avoids a natively installed Postgres on 5432.
DATABASE_URL=postgresql://whizchool:whizchool@localhost:5433/whizchool
# The web app. Email links point here, and it is the origin allowed to make state-changing requests.
APP_URL=http://localhost:3000
# Set when running behind Caddy/a load balancer so client IPs and HTTPS are detected.
TRUST_PROXY=false
LOG_LEVEL=debug

# Email: "smtp" sends to Mailpit in development (inbox at http://localhost:8025).
# Production uses "resend" with RESEND_API_KEY.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:2525
EMAIL_FROM=Whizchool <no-reply@whizchool.lk>
# RESEND_API_KEY=

# Development conveniences (both refused in production):
# return invite/reset links in API responses, and mount the contract-test reset route.
EXPOSE_DEV_LINKS=true
ENABLE_TEST_ROUTES=false
