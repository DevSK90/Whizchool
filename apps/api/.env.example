# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
# Docker Compose Postgres (see docker-compose.yml); 5433 avoids a natively installed Postgres on 5432.
DATABASE_URL=postgresql://whizchool:whizchool@localhost:5433/whizchool
# The web app. Email links point here, and it is the origin allowed to make state-changing requests.
APP_URL=http://localhost:3000
# Set when running behind Caddy/a load balancer so client IPs and HTTPS are detected.
TRUST_PROXY=false
LOG_LEVEL=debug

# Email: "smtp" sends to Mailpit in development (inbox at http://localhost:8025).
# Production uses "resend" with RESEND_API_KEY.
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:2525
EMAIL_FROM=Whizchool <no-reply@whizchool.lk>
# RESEND_API_KEY=

# SMS: "mailpit" shows each SMS in the Mailpit inbox (as mail to <number>@sms.test); "log" only records it.
# Production uses "notifylk" with the school's account and approved sender ID (set in School settings).
SMS_TRANSPORT=mailpit
# NOTIFYLK_USER_ID=
# NOTIFYLK_API_KEY=

# Online payments (PayHere). "fake" (the default outside production) sends parents to the app's own
# sandbox page, so no PayHere account is needed. "sandbox" uses sandbox.payhere.lk with your sandbox
# merchant ID and secret; PayHere must then reach PUBLIC_API_URL (use a tunnel such as cloudflared
# or ngrok on a laptop). "live" takes real payments (production).
PAYHERE_MODE=fake
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PUBLIC_API_URL=https://your-tunnel.example.com

# Background jobs (message delivery, retries, monthly invoices, nightly cleanup): "pgboss" runs a queue in Postgres;
# "inline" runs each job straight away in the request (tests use this).
JOBS_MODE=pgboss

# Development conveniences (both refused in production):
# return invite/reset links in API responses, and mount the contract-test reset route.
EXPOSE_DEV_LINKS=true
ENABLE_TEST_ROUTES=false
